{
	"info": {
		"_postman_id": "b2c3d4e5-f6a7-8901-bcde-f23456789012",
		"name": "API POS - Empleados",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Empleados",
			"item": [
				{
					"name": "Crear Empleado (POST)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"sucursal\": \"{{sucursalId}}\",\n    \"usuario\": \"{{usuarioId}}\",\n    \"nombre\": \"Empleado Test\",\n    \"puesto\": \"Cajero\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/empleados",
							"host": ["{{baseUrl}}"],
							"path": ["api", "empleados"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response._id) {",
									"    pm.environment.set(\"empleadoId\", response._id);",
									"    console.log(\"ID de empleado guardado:\", response._id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Listar Todos los Empleados (GET)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/empleados",
							"host": ["{{baseUrl}}"],
							"path": ["api", "empleados"]
						}
					}
				},
				{
					"name": "Empleados por Sucursal (GET)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/empleados/sucursal/{{sucursalId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "empleados", "sucursal", "{{sucursalId}}"]
						}
					}
				},
				{
					"name": "Obtener Empleado por ID (GET)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/empleados/{{empleadoId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "empleados", "{{empleadoId}}"]
						}
					}
				},
				{
					"name": "Actualizar Empleado (PUT)",
					"request": {
						"method": "PUT",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombre\": \"Empleado Modificado\",\n    \"puesto\": \"Gerente\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/empleados/{{empleadoId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "empleados", "{{empleadoId}}"]
						}
					}
				},
				{
					"name": "Baja Lógica de Empleado (DELETE)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/empleados/{{empleadoId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "empleados", "{{empleadoId}}"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000"
		}
	]
